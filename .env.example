# Web arayüzü (zorunlu: APP_PASSWORD olmadan arayüz açılmaz)
APP_USERNAME=admin
APP_PASSWORD=
# Form jetonları için sabit gizli değer (boşsa her yeniden başlatmada yenilenir)
APP_SECRET=

# LLM arka ucu: anthropic | openai_compat
LLM_BACKEND=anthropic
ANTHROPIC_API_KEY=
LLM_MODEL=claude-opus-5-5
# Yerel model (OpenAI uyumlu uç nokta), LLM_BACKEND=openai_compat iken
OPENAI_COMPAT_BASE_URL=http://localhost:8000/v1
OPENAI_COMPAT_API_KEY=
OPENAI_COMPAT_MODEL=

# Graf deposu: neo4j | memory (memory = data/graph.json, Neo4j olmadan geliştirme/test)
GRAPH_BACKEND=neo4j
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
# Neo4j 5 en az 8 karakter ister
NEO4J_PASSWORD=change-me-please
# Ajan yalnızca bu salt-okunur kullanıcıyla bağlanır (Neo4j Enterprise'da reader rolü; Community'de READ erişim modu + Cypher filtresi)
NEO4J_READ_USER=
NEO4J_READ_PASSWORD=

# Polite pool için iletişim adresi (Crossref / Europe PMC)
CONTACT_EMAIL=
SEMANTIC_SCHOLAR_API_KEY=
